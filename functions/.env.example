# Pexels API Key
# Required for fetching random potluck images from Pexels API
# Get your free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Backfill Secret
# Required for protecting the backfillEventImages admin endpoint
# Set this to a secure random string
BACKFILL_SECRET=your_secure_secret_here
