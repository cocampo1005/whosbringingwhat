{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "mf-stats.json"],
    "headers": [
      {
        "source": "/mf-manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "/remoteEntry.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "/build-info.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/randomPotluckImage",
        "function": "randomPotluckImage"
      },
      {
        "source": "/internal/backfillEventImages",
        "function": "backfillEventImages"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
